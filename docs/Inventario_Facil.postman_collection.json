  "item": [
    {
      "name": "01 - Autenticación y perfil",
      "description": "Endpoints de autenticación, sesión, perfil y recuperación de contraseña. Login, register y refresh guardan automáticamente access_token y user_id cuando la respuesta los contiene. El refresh token se maneja como cookie HttpOnly; Postman conserva la cookie automáticamente si el Cookie Jar está habilitado.",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "description": "Registra un nuevo usuario. La ruta actual acepta los roles client, provider y user; el ejemplo usa user.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Usuario Postman\",\n  \"email\": \"nuevo.usuario@ejemplo.com\",\n  \"password\": \"Password123\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) pm.collectionVariables.set('access_token', data.accessToken);",
                  "    if (data.user && data.user.id) pm.collectionVariables.set('user_id', String(data.user.id));",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Inicia sesión. Si la respuesta es exitosa, la colección guarda accessToken en {{access_token}} y el id del usuario en {{user_id}}. El refresh token queda en la cookie de Postman.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) pm.collectionVariables.set('access_token', data.accessToken);",
                  "    if (data.user && data.user.id) pm.collectionVariables.set('user_id', String(data.user.id));",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sesión",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/refresh",
            "description": "Renueva el access token utilizando la cookie refreshToken creada por login/register. Mantenga habilitado el Cookie Jar de Postman.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) pm.collectionVariables.set('access_token', data.accessToken);",
                  "    if (data.user && data.user.id) pm.collectionVariables.set('user_id', String(data.user.id));",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/logout",
            "description": "Revoca el refresh token de la sesión actual y elimina su cookie.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Obtener mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "description": "Obtiene el perfil asociado al JWT actual."
          },
          "response": []
        },
        {
