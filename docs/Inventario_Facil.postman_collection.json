        {
          "name": "Cambiar mi contraseña",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/me/password",
            "description": "Cambia la contraseña del usuario autenticado. La nueva contraseña debe tener al menos 8 caracteres y contener un número.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordNueva\": \"NuevaClave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/{{user_id}}",
            "description": "Consulta un usuario por su identificador."
          },
          "response": []
        },
        {
          "name": "Solicitar OTP de recuperación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/password/otp",
            "description": "Solicita un código OTP para recuperación de contraseña. Si la respuesta contiene recoveryId, se guarda automáticamente en {{recovery_id}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recovery_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  try {",
                  "    const data = pm.response.json();",
                  "    const recoveryId = data.recoveryId || (data.data && data.data.recoveryId);",
                  "    if (recoveryId) pm.collectionVariables.set('recovery_id', recoveryId);",
                  "  } catch (e) {}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/password/otp/verify",
            "description": "Verifica el OTP de seis dígitos enviado por correo. Coloque el código recibido en {{otp_code}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recoveryId\": \"{{recovery_id}}\",\n  \"otp\": \"{{otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/password/reset",
            "description": "Restablece la contraseña después de verificar correctamente el OTP.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recoveryId\": \"{{recovery_id}}\",\n  \"passwordNueva\": \"PasswordNueva123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
